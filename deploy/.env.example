# Copy to .env and fill in. deploy/up.sh reads this, and REWRITES the keys the
# Logto seed owns -- so anything you set for those is replaced, not merged.

# The one value everything else is derived from: <public-ip>.sslip.io.
#
# sslip.io is a public wildcard resolver that reads the address out of the
# hostname, so a.b.c.d.sslip.io and anything.a.b.c.d.sslip.io both resolve to
# a.b.c.d. Nothing to register, no zone, no records, no renewal -- which is the
# whole reason it is here rather than a domain.
BASE=203.0.113.10.sslip.io

# Caddy global options, as a whole directive. Empty is fine and is what a local
# run wants; production should set an ACME contact:
#   CADDY_GLOBAL="email you@example.com"
CADDY_GLOBAL=

# EMPTY in production, so Caddy provisions a real certificate over HTTP-01.
# Set to "tls internal" (QUOTED -- it contains a space, and up.sh sources
# this file with the shell) for a local run: Let's Encrypt cannot validate a
# 127.0.0.1.sslip.io name, because it cannot reach your laptop to do it.
CADDY_TLS=

# 1 while CADDY_TLS is internal, so the seed accepts Caddy's own CA. MUST be 0
# in production -- with a real certificate there is nothing to excuse, and
# leaving it at 1 would let the seed talk to anything claiming to be Logto.
SEED_TLS_INSECURE=1

# Postgres. The second is the role the control plane actually runs as, and it
# deliberately holds neither DDL nor BYPASSRLS.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

# Where the images come from. Empty-ish default builds and runs locally;
# on AWS this is the ECR registry host.
REGISTRY=lemul
TAG=dev
AWS_REGION=us-east-2

# Where sign-in codes are sent. The defaults are the local Mailpit container,
# which has NO AUTHENTICATION -- and since sign-in is passwordless email, anyone
# who can read that inbox can sign in as anyone. Fine on a laptop, never on a
# host with a public address: point these at a real provider there.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=lemul
SMTP_PASS=lemul
SMTP_SECURE=false
SMTP_FROM=lemul@localhost

# WHO MAY SIGN UP. Comma-separated exact addresses, whole domains, or
# wildcards. EMPTY MEANS ANYONE with a working mailbox -- correct on a laptop,
# wrong on anything with a public address.
#
# Do not rely on SES sandbox mode for this. It refuses to deliver to unverified
# addresses, so sign-up LOOKS closed, but that is the mail configuration doing
# it by accident and it ends the day SES gets production access.
SIGNUP_ALLOWLIST=

# Console feature flags. FF_WORKSPACE_EXPLORER adds the filesystem and
# processes tabs -- safe only where a workspace has ONE member, because the
# explorer is served by the root supervisor and can read across member homes.
FF_WORKSPACE_EXPLORER=
FF_VIEW_SESSION=

# Inference (decision #12). The control plane points every session at the
# gateway; the gateway points at Bedrock.
#
# LEMUL_GATEWAY_URL is an INTERNAL address: the supervisor reaches it through
# the control plane's configuration, not through the browser, so it never needs
# to leave the compose network.
LEMUL_GATEWAY_URL=http://litellm:4000
LEMUL_GATEWAY_KEY=change-me-gateway-master-key

# A Bedrock API key (ABSK...). A bearer token, so this host needs no IAM
# principal that can invoke a model -- and it is a password: whoever holds it
# can spend against the account that issued it.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-2

# The LiteLLM admin UI's own login, deliberately NOT the master key: that
# one is the inference credential every workspace task holds.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me-ui-password

# What Claude Code asks for, and what litellm.yaml answers to. These three
# strings appear in BOTH files and must match exactly.
LEMUL_PINS=opus=claude-opus-4-8,sonnet=claude-sonnet-4-6,haiku=claude-haiku-4-5

# --- Written by up.sh from the Logto seed. Do not hand-edit. ---
# Empty on a first run. They cannot be required by compose, which interpolates
# the whole file even when starting only the identity provider that mints them.
LEMUL_AUTH_AUDIENCE=https://api.lemul.local
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
LEMUL_CLI_CLIENT_ID=
LEMUL_CONSOLE_CLIENT_ID=
